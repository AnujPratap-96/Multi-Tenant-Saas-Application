generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////
enum Role {
  ADMIN
  MANAGER
  USER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

//////////////////////
// USERS (GLOBAL IDENTITY)
//////////////////////
model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String?
  // 👤 Identity
  firstName             String?
  lastName              String?
  avatarUrl             String?
  emailVerified         Boolean                @default(false)
  isActive              Boolean                @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  ownedTenants          Tenant[]               @relation("TenantOwner")
  tenantUsers           TenantUser[]
  projectMembers        ProjectMember[]
  projects              Project[]              @relation("ProjectCreator")
  tasksCreated          Task[]                 @relation("TaskCreator")
  taskAssignees         TaskAssignee[]
  comments              TaskComment[]
  auditLogsAsActor      AuditLog[]             @relation("AuditActor")
  auditLogsAsSubject    AuditLog[]             @relation("AuditSubject")
  tasksUpdated          Task[]                 @relation("TaskUpdater")
  tenantUserPermissions TenantUserPermission[]
  tenantInvitations     TenantUser[]           @relation("TenantUserInviter")
  tenantOwnerships      TenantOwnership[]
  sessions              AuthSession[]
  tenantInvitesSent     TenantInvite[]         @relation("TenantInviteInviter")
}

//////////////////////
// TENANTS (ORGANIZATION)
//////////////////////
model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  ownerUserId           String
  owner                 User                   @relation("TenantOwner", fields: [ownerUserId], references: [id])
  plan                  String                 @default("FREE")
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  tenantUsers           TenantUser[]
  projects              Project[]
  tasks                 Task[]
  auditLogs             AuditLog[]
  tenantOwnerships      TenantOwnership[]
  tenantUserPermissions TenantUserPermission[]
  tenantInvites         TenantInvite[]
  settings              TenantSettings?
}

model TenantOwnership {
  tenantId   String
  userId     String
  assignedAt DateTime  @default(now())
  removedAt  DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@id([tenantId, userId])
}

//////////////////////
// TENANT USERS (RBAC CORE)
//////////////////////
model TenantUser {
  tenantId    String
  userId      String
  role        Role
  status      TenantUserStatus @default(ACTIVE)
  invitedById String?
  invitedBy   User?            @relation("TenantUserInviter", fields: [invitedById], references: [id])
  joinedAt    DateTime         @default(now())
  removedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@id([tenantId, userId])
}

enum TenantUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

//////////////////////
// TENANT INVITES (EMAIL-KEYED, D-7)
//////////////////////
model TenantInvite {
  id          String             @id @default(uuid())
  tenantId    String
  email       String
  role        Role
  invitedById String?
  invitedBy   User?              @relation("TenantInviteInviter", fields: [invitedById], references: [id])
  tokenHash   String
  status      TenantInviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  acceptedAt  DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([email])
}

enum TenantInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

//////////////////////
// TENANT SETTINGS (DB-BACKED, D-14)
//////////////////////
model TenantSettings {
  tenantId  String   @id
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

//////////////////////
// PROJECTS
//////////////////////
model Project {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdById String?
  createdBy   User?           @relation("ProjectCreator", fields: [createdById], references: [id])
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  members     ProjectMember[]
  tasks       Task[]
}

//////////////////////
// PROJECT MEMBERS
//////////////////////
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  addedAt   DateTime    @default(now())
  removedAt DateTime?
  project   Project     @relation(fields: [projectId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

enum ProjectRole {
  OWNER
  MAINTAINER
  MEMBER
}

//////////////////////
// TASKS
//////////////////////
model Task {
  id          String         @id @default(uuid())
  tenantId    String
  projectId   String
  title       String
  description String?
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  createdById String?
  createdBy   User?          @relation("TaskCreator", fields: [createdById], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  updatedById String?
  updatedBy   User?          @relation("TaskUpdater", fields: [updatedById], references: [id])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id])
  assignees   TaskAssignee[]
  comments    TaskComment[]
}

//////////////////////
// TASK ASSIGNEES
//////////////////////
model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime  @default(now())
  removedAt  DateTime?
  task       Task      @relation(fields: [taskId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

//////////////////////
// TASK COMMENTS
//////////////////////
model TaskComment {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  task      Task      @relation(fields: [taskId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

//////////////////////
// AUDIT LOGS
//////////////////////
model AuditLog {
  id            String       @id @default(uuid())
  tenantId      String?
  actorUserId   String?
  subjectUserId String?
  action        AuditAction?
  entityType    AuditEntity
  entityId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  tenant        Tenant?      @relation(fields: [tenantId], references: [id])
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id])
  subject       User?        @relation("AuditSubject", fields: [subjectUserId], references: [id])

  @@index([tenantId])
  @@index([actorUserId])
  @@index([subjectUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  INVITE
  REMOVE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  PASSWORD_CHANGE
  PASSWORD_SET
  ROLE_CHANGE

  // Tenant
  ADD_MEMBER
  REMOVE_MEMBER
  SUSPEND_MEMBER
  RESTORE_MEMBER
  SWITCH_TENANT
  RESTORE
  INVITE_ACCEPTED
  INVITE_REJECTED
  INVITE_CANCELLED
  INVITE_RESENT

  // Project
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_ARCHIVE
  PROJECT_MEMBER_ADD
  PROJECT_MEMBER_REMOVE
  PROJECT_MEMBER_UPDATE

  // Task
  TASK_CREATE
  TASK_UPDATE
  TASK_DELETE
  TASK_STATUS_CHANGE
  TASK_ASSIGNEE_ADD
  TASK_ASSIGNEE_REMOVE
  TASK_COMMENT_ADD
  TASK_COMMENT_DELETE
}

enum AuditEntity {
  USER
  TENANT
  PROJECT
  TASK
  COMMENT
  SESSION
}

//////////////////////
// AUTH SESSIONS
//////////////////////
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRevoked])
  @@unique([refreshTokenHash])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions       RolePermission[]
  tenantUserPermissions TenantUserPermission[]

  @@unique([resource, action]) // ADD THIS
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("Roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RoleDefinition       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model TenantUserPermission {
  tenantId     String
  userId       String
  permissionId String

  // Optional but very useful later
  isAllowed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@id([tenantId, userId, permissionId])
  @@index([tenantId, userId])
  @@index([tenantId, permissionId])
}
